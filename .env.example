# ─────────────────────────────────────────────────────────────
# Variables d'environnement de « Déjà Vu »
# Copie ce fichier en .env.local et remplis les valeurs.
# En production (Vercel) : recopie ces clés dans
# Settings → Environment Variables (NE PAS committer .env.local).
# ─────────────────────────────────────────────────────────────

# ── Supabase (obligatoire) ──
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Google OAuth (Drive + Agenda + envoi d'invitations) — optionnel ──
# Console Google Cloud → API & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── OpenRouteService (calcul d'itinéraires logistiques) — optionnel ──
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ── Gemini (résumé de réunions + extraction d'actions) — optionnel ──
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
